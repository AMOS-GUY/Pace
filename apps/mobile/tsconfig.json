{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@pace/*": ["../../packages/*/src/index.ts"],
      "pace-tracking": ["./modules/pace-tracking/index.ts"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "app.config.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "ios", "android"]
}
