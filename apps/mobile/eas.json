{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.18.0",
      "pnpm": "12.18.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" },
      "ios": { "simulator": false, "image": "latest" }
    },
    "simulator": {
      "extends": "base",
      "developmentClient": true,
      "env": { "APP_VARIANT": "development" },
      "ios": { "simulator": true, "image": "latest" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "image": "latest" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "ios": { "image": "latest" }
    }
  },
  "submit": {
    "production": {}
  }
}
