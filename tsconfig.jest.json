{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "types": ["node", "jest"],
    "paths": {
      "@pace/*": ["./packages/*/src/index.ts"],
      "@/*": ["./apps/mobile/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/mobile/src/**/*.test.ts"]
}
