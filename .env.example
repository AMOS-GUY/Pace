# PACE environment template. Copy the relevant section to:
#   apps/mobile/.env   (public values only — bundled into the app)
#   apps/api/.env      (server secrets — never commit, never ship to clients)
# Placeholders only. Never commit real credentials.

# ---------------------------------------------------------------- mobile (apps/mobile/.env)
# Supabase project URL and *publishable* (anon) key. Safe to embed in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# PACE API base URL (optional; enables cloud backup, sync and account deletion).
EXPO_PUBLIC_API_URL=https://api.example.com
# MapLibre style URL from a properly licensed tile provider (optional; without it routes are
# drawn as vector outlines). Do NOT use the public OpenStreetMap tile servers in production.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.example.com/styles/dark/style.json

# ---------------------------------------------------------------- api (apps/api/.env)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pace:pace@localhost:5432/pace
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional legacy HS256 JWT secret. Leave unset to verify tokens via the project's JWKS.
# SUPABASE_JWT_SECRET=
# Server-only; required for account deletion. NEVER put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
# S3-compatible storage for encrypted cloud backups (R2, S3, MinIO, Supabase Storage S3).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=pace-backups
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true
# Comma-separated browser origins allowed by CORS (the mobile app needs none).
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
# Optional JSON entitlement configuration (no prices): {"defaultPlan":"free","plans":{"free":{"features":["recording"]}}}
# ENTITLEMENTS_JSON=
